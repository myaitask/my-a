# ==============================================================================
# MY AI TASK (Next.js 15 Social Automation & CRM Portal)
# Domain: https://automate.myaitask.com
# ==============================================================================

# Core Application & Ecosystem Domains
NEXT_PUBLIC_APP_URL=https://automate.myaitask.com
NEXT_PUBLIC_SITE_URL=https://www.myaitask.com
NEXT_PUBLIC_BACKEND_URL=https://api.myaitask.com

# Internal Security Gateway Secret
INTERNAL_API_SECRET=your_internal_api_secret

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Meta Developer & Tech Provider Credentials
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=your_meta_verify_token
META_GRAPH_VERSION=v26.0

# Inngest Serverless Queue (Free Tier)
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# Resend Transactional Email Service
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=team@myaitask.com
RESEND_FROM_NAME="My AI Task"
RESEND_REPLY_TO=myaitasks@gmail.com

# Cloudinary Media Assets
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=your_cloudinary_url

# Razorpay Payment Gateway (Test Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
